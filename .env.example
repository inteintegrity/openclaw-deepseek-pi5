# Replace all three values with an OpenAI-compatible DeepSeek endpoint.
DEEPSEEK_BASE_URL=https://YOUR_GATEWAY/v1
DEEPSEEK_API_KEY=replace-with-your-api-key
DEEPSEEK_MODEL=replace-with-your-model-id

# Set true only for an administrator-approved LAN model endpoint.
ALLOW_PRIVATE_NETWORK=false

# The default is local access, including through an SSH tunnel from your PC.
HOST_PORT=18889
BIND_ADDRESS=127.0.0.1
PUBLIC_ORIGIN=http://localhost:18889

# Optional. Leave empty to generate a token once and retain it in the data volume.
OPENCLAW_GATEWAY_TOKEN=
